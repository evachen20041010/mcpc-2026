---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import VenueSection from "../components/VenueSection.astro";
import PageHero from "../components/common/PageHero.astro";
---

<Layout
  title="2026 行動通訊實務競賽 | 交通地點"
  description="2026 行動通訊實務競賽官方網站。聚焦下世代行動通訊技術應用，邀請全國大專校院學生組隊參與，展現行動通訊跨域整合與實作創新力。"
>
  <Navbar />

  <main class="pt-20">
    <PageHero eyebrow="VENUE & TRANSPORTATION" title="交通地點" />

    <VenueSection standalone={true} />
  </main>

  <Footer />
</Layout>
