---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import NewsSection from "../components/NewsSection.astro";
import RulesOverviewSection from "../components/RulesOverviewSection.astro";
import RegistrationSection from "../components/RegistrationSection.astro";
import DownloadSection from "../components/DownloadSection.astro";
import VenueSection from "../components/VenueSection.astro";
import ContactFaqSection from "../components/ContactFaqSection.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="2026 行動通訊實務競賽 | 官方網站"
  description="2026 行動通訊實務競賽官方網站。聚焦下世代行動通訊技術應用，邀請全國大專校院學生組隊參與，展現行動通訊跨域整合與實作創新力。"
>
  <Navbar />

  <main class="w-full max-w-full overflow-x-hidden">
    <Hero />
    <NewsSection />
    <RulesOverviewSection />
    <RegistrationSection />
    <DownloadSection />
    <VenueSection />
    <ContactFaqSection />
  </main>

  <Footer />
</Layout>
