---
import { registrationSteps } from "../data/registrationProcessData";
---

<section id="registration" class="relative overflow-hidden bg-bg-light py-20">
  <div
    class="pointer-events-none absolute right-0 top-0 h-96 w-96 -translate-y-1/2 translate-x-1/2 rounded-full bg-blue-100/40 blur-3xl"
  >
  </div>

  <div
    class="pointer-events-none absolute bottom-0 left-0 h-96 w-96 -translate-x-1/2 translate-y-1/2 rounded-full bg-sky-100/40 blur-3xl"
  >
  </div>

  <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-16 text-center">
      <h2 class="relative inline-block text-3xl font-bold text-slate-800">
        報名流程

        <span
          class="absolute bottom-[-10px] left-1/2 h-1 w-12 -translate-x-1/2 rounded-full bg-primary"
        >
        </span>
      </h2>
    </div>

    <div class="mb-16 grid gap-8 md:grid-cols-2 lg:grid-cols-4">
      {
        registrationSteps.map((item) => (
          <div class="group relative rounded-3xl border border-slate-100 bg-white p-8 text-center shadow-[0_4px_20px_rgba(0,0,0,0.03)] transition-all duration-300 hover:-translate-y-2 hover:border-primary/20 hover:shadow-[0_8px_30px_rgba(0,0,0,0.06)]">
            <div class="mx-auto mb-6 flex h-20 w-20 items-center justify-center rounded-2xl bg-blue-50 text-3xl font-bold text-primary transition-colors duration-500 group-hover:bg-primary group-hover:text-white">
              {item.step}
            </div>

            <h3 class="mb-3 text-xl font-bold text-slate-800">{item.title}</h3>

            <p class="leading-relaxed text-slate-500">{item.desc}</p>
          </div>
        ))
      }
    </div>

    <div class="text-center">
      <a
        href="/upload/register"
        class="group relative mb-12 inline-flex items-center justify-center overflow-hidden rounded-2xl bg-primary px-8 py-4 font-bold tracking-[0.08em] text-white shadow-[0_12px_24px_rgba(26,79,110,0.2)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_18px_30px_rgba(26,79,110,0.28)]"
      >
        <div
          class="absolute inset-0 origin-left scale-x-0 bg-white/20 transition-transform duration-500 group-hover:scale-x-100"
        >
        </div>

        <span class="relative z-10"> 前往線上報名 → </span>
      </a>

      <div class="mx-auto max-w-3xl">
        <div
          class="flex flex-col items-start gap-5 rounded-2xl border border-primary/10 bg-white p-6 text-left shadow-sm transition-shadow hover:shadow-md md:flex-row md:items-center"
        >
          <div
            class="flex h-14 w-14 flex-shrink-0 items-center justify-center rounded-full bg-amber-300 shadow-md shadow-amber-200"
          >
            <img
              src="/images/lightbulb.png"
              alt="Lightbulb"
              class="h-7 w-7 object-contain opacity-95"
              style="filter: brightness(0) invert(1);"
            />
          </div>

          <div>
            <h4 class="mb-2 text-lg font-bold text-slate-800">
              報名狀態查詢說明
            </h4>

            <p class="leading-relaxed text-slate-600">
              完成報名後，系統將自動寄發確認信。如需查詢報名進度或修改資料，請來信，並於信中註明您的「隊伍名稱」與「隊長姓名」，我們將盡快為您查詢。
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
