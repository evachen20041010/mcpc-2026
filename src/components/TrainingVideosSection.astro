---
import { trainingVideoGroups } from "../data/trainingVideoData";

const defaultGroup = "directional-security";
---

<section
  id="training-videos"
  class="relative overflow-hidden bg-white py-20 lg:py-24"
>
  <!-- 淡淡背景 -->
  <div
  class="pointer-events-none absolute inset-0 bg-gradient-to-b from-slate-50/50 via-white to-white"
>
</div>

  <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- 標題 -->
    <div class="mb-12 text-center">
      <h2 class="relative inline-block text-3xl font-bold text-slate-800">
        培訓營影片
        <span
          class="absolute bottom-[-10px] left-1/2 h-1 w-12 -translate-x-1/2 rounded-full bg-primary"
        >
        </span>
      </h2>
    </div>

    <!-- 組別切換 -->
    <div
      class="mx-auto mb-10 flex max-w-5xl flex-wrap justify-center gap-3"
      role="tablist"
      aria-label="培訓營組別"
    >
      {
        trainingVideoGroups.map((group) => (
          <button
            type="button"
            role="tab"
            data-training-tab={group.id}
            aria-selected={group.id === defaultGroup ? "true" : "false"}
            class:list={[
              "training-tab rounded-full border px-5 py-2.5 text-sm font-bold transition-all duration-300",
              group.id === defaultGroup
                ? "border-primary bg-primary text-white shadow-sm"
                : "border-slate-200 bg-white text-slate-600 hover:border-primary/40 hover:text-primary",
            ]}
          >
            {group.label}
          </button>
        ))
      }
    </div>

    <!-- 各組內容 -->
    {
      trainingVideoGroups.map((group) => (
        <div
          data-training-panel={group.id}
          hidden={group.id !== defaultGroup}
          role="tabpanel"
          class="mx-auto max-w-6xl"
        >
          <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
            {group.videos.map((video) => (
              <article
                class="min-w-0 overflow-hidden rounded-[1.5rem] border border-slate-200 bg-white shadow-sm transition-all duration-300 hover:border-primary/30 hover:shadow-lg"
              >
                <!-- YouTube -->
                {video.type === "youtube" && video.youtubeId && (
                  <div
                    class="relative aspect-video w-full overflow-hidden bg-slate-900"
                  >
                    <iframe
                      src={`https://www.youtube-nocookie.com/embed/${video.youtubeId}`}
                      title={`${video.title}培訓營影片`}
                      class="absolute inset-0 h-full w-full"
                      loading="lazy"
                      referrerpolicy="strict-origin-when-cross-origin"
                      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                      allowfullscreen
                    />
                  </div>
                )}

                <!-- Google Drive -->
                {video.type === "drive" && video.href && (
                  <a
                    href={video.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group flex aspect-video w-full flex-col items-center justify-center bg-slate-50 transition-colors hover:bg-sky-50/70"
                    aria-label={`開啟 ${video.title} 培訓資料`}
                  >
                    <div
                      class="mb-4 flex h-14 w-14 items-center justify-center rounded-full border border-slate-200 bg-white text-primary shadow-sm transition-transform group-hover:scale-105"
                    >
                      <svg
                        class="h-7 w-7"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M3 7.5A2.5 2.5 0 0 1 5.5 5h4l2 2h7A2.5 2.5 0 0 1 21 9.5v8A2.5 2.5 0 0 1 18.5 20h-13A2.5 2.5 0 0 1 3 17.5v-10Z"
                        />
                      </svg>
                    </div>

                    <p class="font-bold text-slate-700">
                      培訓營資料
                    </p>

                    <p class="mt-1 text-sm text-slate-400">
                      點擊開啟 Google Drive
                    </p>
                  </a>
                )}

                <!-- 尚未提供 -->
                {video.type === "pending" && (
                  <div
                    class="flex aspect-video w-full flex-col items-center justify-center bg-slate-50"
                  >
                    <div
                      class="mb-4 flex h-14 w-14 items-center justify-center rounded-full border border-slate-200 bg-white text-primary/70 shadow-sm"
                    >
                      <svg
                        class="ml-0.5 h-6 w-6"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                      >
                        <path d="M8 5v14l11-7z" />
                      </svg>
                    </div>

                    <p class="font-bold text-slate-600">
                      影片整理中
                    </p>

                    <p class="mt-1 text-sm text-slate-400">
                      後續將更新培訓營影片
                    </p>
                  </div>
                )}

                <!-- 文字資訊 -->
                <div class="p-6">
                  <div class="mb-4 flex flex-wrap items-center gap-2">
                    <span
                      class="rounded-full bg-primary/10 px-3 py-1 text-xs font-bold text-primary"
                    >
                      {video.axis}
                    </span>

                    {video.type === "youtube" && (
                      <span class="text-xs font-bold text-red-500">
                        YouTube
                      </span>
                    )}

                    {video.type === "drive" && (
                      <span class="text-xs font-bold text-sky-600">
                        Google Drive
                      </span>
                    )}

                    {video.type === "pending" && (
                      <span class="text-xs font-bold text-slate-400">
                        尚未上線
                      </span>
                    )}
                  </div>

                  <h3
                    class="mb-4 text-xl font-black leading-snug text-slate-800"
                  >
                    {video.title}
                  </h3>

                  <div
                    class="flex min-w-0 items-start gap-2 text-sm leading-relaxed text-slate-500"
                  >
                    <svg
                      class="mt-0.5 h-5 w-5 shrink-0 text-primary"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M9.75 17 3 12l6.75-5M14.25 7 21 12l-6.75 5"
                      />
                    </svg>

                    <span class="min-w-0">
                      {video.platform}
                    </span>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const tabs = document.querySelectorAll<HTMLElement>(
      "[data-training-tab]",
    );

    const panels = document.querySelectorAll<HTMLElement>(
      "[data-training-panel]",
    );

    const setActiveGroup = (groupId: string) => {
        tabs.forEach((tab) => {
            const isActive = tab.dataset.trainingTab === groupId;

            tab.setAttribute("aria-selected", String(isActive));

            // 選取狀態
            tab.classList.toggle("bg-primary", isActive);
            tab.classList.toggle("text-white", isActive);
            tab.classList.toggle("border-primary", isActive);
            tab.classList.toggle("shadow-sm", isActive);

            // 未選取狀態
            tab.classList.toggle("bg-white", !isActive);
            tab.classList.toggle("text-slate-600", !isActive);
            tab.classList.toggle("border-slate-200", !isActive);

            // 只有未選取的按鈕才能有 hover 藍字
            tab.classList.toggle("hover:text-primary", !isActive);
            tab.classList.toggle("hover:border-primary/40", !isActive);
        });

        panels.forEach((panel) => {
            panel.hidden =
            panel.dataset.trainingPanel !== groupId;
        });
    };

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const groupId = tab.dataset.trainingTab;

        if (groupId) {
          setActiveGroup(groupId);
        }
      });
    });
  });
</script>
