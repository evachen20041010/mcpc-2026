---
const currentPath = Astro.url.pathname;

const isActive = (path: string) => {
  if (path === "/") return currentPath === "/";
  return currentPath === path || currentPath.startsWith(`${path}/`);
};

const themeLinks = [
  {
    href: "/themes/energy-iot",
    label: "智慧節能與物聯網應用組",
  },
  {
    href: "/themes/directional-security",
    label: "智慧指向性傳輸暨通訊網路與資訊安全組",
  },
  {
    href: "/themes/digital-app",
    label: "智慧數位應用組",
  },
];

const uploadLinks = [
  {
    href: "/upload/register",
    label: "線上報名",
  },
  {
    href: "/upload/preliminary",
    label: "初賽文件上傳",
  },
  {
    href: "/upload/final",
    label: "決賽文件上傳",
  },
];

const navLinks = [
  {
    href: "/",
    label: "首頁",
  },
  {
    href: "/news",
    label: "最新消息",
  },
  {
    href: "/rules",
    label: "競賽辦法",
  },
  {
    href: "/downloads",
    label: "檔案下載",
  },
  {
    href: "/venue",
    label: "交通地點",
  },
];

const isThemeActive = themeLinks.some((link) => isActive(link.href));
const isUploadActive = uploadLinks.some((link) => isActive(link.href));
---

<nav
  id="main-navbar"
  class="fixed inset-x-0 top-0 z-[999] w-full translate-y-0 overflow-visible border-b border-slate-200 bg-white/95 shadow-sm backdrop-blur-md transition-transform duration-300 ease-out will-change-transform"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-20 items-center justify-between">
      <!-- Logo -->
      <div class="min-w-0 flex-shrink-0">
        <a
          href="/"
          class="flex min-w-0 cursor-pointer items-baseline font-bold text-primary"
        >
          <span class="whitespace-nowrap text-xl lg:text-2xl">2026 MCPC</span>
          <span
            class="ml-2.5 hidden whitespace-nowrap text-[1rem] font-bold tracking-wide text-slate-500 sm:inline"
          >
            | 行動通訊實務競賽
          </span>
        </a>
      </div>

      <!-- Desktop navigation -->
      <div class="hidden items-center gap-8 lg:flex">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class={`relative text-base font-bold transition-colors duration-300 ${
                isActive(link.href)
                  ? "text-primary"
                  : "text-slate-700 hover:text-primary"
              }`}
            >
              {link.label}
              <span
                class={`absolute -bottom-2 left-0 h-0.5 rounded-full bg-primary transition-all duration-300 ${
                  isActive(link.href) ? "w-full" : "w-0"
                }`}
              />
            </a>
          ))
        }

        <div class="group relative" data-theme-root>
          <button
            type="button"
            class={`relative flex items-center gap-1 text-base font-bold transition-colors duration-300 ${
              isThemeActive
                ? "text-primary"
                : "text-slate-700 hover:text-primary"
            }`}
            data-theme-button
          >
            競賽主題資訊
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-4 w-4 transition-transform duration-300 group-hover:rotate-180"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m6 9 6 6 6-6"></path>
            </svg>

            <span
              class={`absolute -bottom-2 left-0 h-0.5 rounded-full bg-primary transition-all duration-300 ${
                isThemeActive ? "w-full" : "w-0 group-hover:w-full"
              }`}></span>
          </button>

          <div
            class="invisible absolute right-0 top-full z-[1000] pt-4 opacity-0 transition-all duration-300 group-hover:visible group-hover:opacity-100"
            data-theme-menu
          >
            <div
              class="w-80 rounded-2xl border border-slate-200 bg-white p-3 shadow-xl"
            >
              {
                themeLinks.map((link) => (
                  <a
                    href={link.href}
                    class={`block rounded-xl px-4 py-3 text-sm font-bold transition-colors ${
                      isActive(link.href)
                        ? "bg-primary/10 text-primary"
                        : "text-slate-700 hover:bg-slate-50 hover:text-primary"
                    }`}
                  >
                    {link.label}
                  </a>
                ))
              }
            </div>
          </div>
        </div>

        <div class="group relative" data-upload-root>
          <button
            type="button"
            class={`relative flex items-center gap-1 text-base font-bold transition-colors duration-300 ${
              isUploadActive
                ? "text-primary"
                : "text-slate-700 hover:text-primary"
            }`}
            data-upload-button
          >
            報名 / 資料上傳
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-4 w-4 transition-transform duration-300 group-hover:rotate-180"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m6 9 6 6 6-6"></path>
            </svg>

            <span
              class={`absolute -bottom-2 left-0 h-0.5 rounded-full bg-primary transition-all duration-300 ${
                isUploadActive ? "w-full" : "w-0 group-hover:w-full"
              }`}></span>
          </button>

          <div
            class="invisible absolute right-0 top-full z-[1000] pt-4 opacity-0 transition-all duration-300 group-hover:visible group-hover:opacity-100"
            data-upload-menu
          >
            <div
              class="w-56 rounded-2xl border border-slate-200 bg-white p-3 shadow-xl"
            >
              {
                uploadLinks.map((link) => (
                  <a
                    href={link.href}
                    class={`block rounded-xl px-4 py-3 text-sm font-bold transition-colors ${
                      isActive(link.href)
                        ? "bg-primary/10 text-primary"
                        : "text-slate-700 hover:bg-slate-50 hover:text-primary"
                    }`}
                  >
                    {link.label}
                  </a>
                ))
              }
            </div>
          </div>
        </div>
      </div>

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-button"
        type="button"
        class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-slate-200 text-slate-700 transition-colors hover:border-primary/30 hover:text-primary lg:hidden"
        aria-label="開啟選單"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <svg
          id="mobile-menu-icon"
          xmlns="http://www.w3.org/2000/svg"
          class="h-6 w-6"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M4 6h16"></path>
          <path d="M4 12h16"></path>
          <path d="M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu: fills the viewport below the 80px navbar and scrolls independently -->
  <div
    id="mobile-menu"
    class="absolute inset-x-0 top-full z-[1000] hidden h-[calc(100dvh-5rem)] overflow-y-auto overscroll-contain border-t border-slate-200 bg-white shadow-lg lg:hidden"
    aria-hidden="true"
  >
    <div
      class="min-h-full space-y-2 px-4 pt-4 pb-[calc(2rem+env(safe-area-inset-bottom))]"
    >
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class={`block rounded-xl px-4 py-3 text-base font-bold transition-colors ${
              isActive(link.href)
                ? "bg-primary/10 text-primary"
                : "text-slate-700 hover:bg-slate-50 hover:text-primary"
            }`}
          >
            {link.label}
          </a>
        ))
      }

      <div class="pt-2">
        <button
          type="button"
          class={`flex w-full items-center justify-between rounded-xl px-4 py-3 text-base font-bold transition-colors ${
            isThemeActive
              ? "bg-primary/10 text-primary"
              : "text-slate-700 hover:bg-slate-50 hover:text-primary"
          }`}
          aria-expanded="false"
          data-mobile-theme-toggle
        >
          競賽主題資訊
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-4 w-4 transition-transform duration-300"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            data-mobile-theme-icon
            aria-hidden="true"
          >
            <path d="m6 9 6 6 6-6"></path>
          </svg>
        </button>

        <div class="mt-2 hidden space-y-2 pl-4" data-mobile-theme-panel>
          {
            themeLinks.map((link) => (
              <a
                href={link.href}
                class={`block rounded-xl px-4 py-3 text-sm font-bold leading-relaxed transition-colors ${
                  isActive(link.href)
                    ? "bg-primary/10 text-primary"
                    : "text-slate-600 hover:bg-slate-50 hover:text-primary"
                }`}
              >
                {link.label}
              </a>
            ))
          }
        </div>
      </div>

      <div class="pt-2">
        <button
          type="button"
          class={`flex w-full items-center justify-between rounded-xl px-4 py-3 text-base font-bold transition-colors ${
            isUploadActive
              ? "bg-primary/10 text-primary"
              : "text-slate-700 hover:bg-slate-50 hover:text-primary"
          }`}
          aria-expanded="false"
          data-mobile-upload-toggle
        >
          報名 / 資料上傳
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-4 w-4 transition-transform duration-300"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            data-mobile-upload-icon
            aria-hidden="true"
          >
            <path d="m6 9 6 6 6-6"></path>
          </svg>
        </button>

        <div class="mt-2 hidden space-y-2 pl-4" data-mobile-upload-panel>
          {
            uploadLinks.map((link) => (
              <a
                href={link.href}
                class={`block rounded-xl px-4 py-3 text-sm font-bold transition-colors ${
                  isActive(link.href)
                    ? "bg-primary/10 text-primary"
                    : "text-slate-600 hover:bg-slate-50 hover:text-primary"
                }`}
              >
                {link.label}
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</nav>

<script>
  const navbar = document.getElementById("main-navbar");
  const mobileMenuButton = document.getElementById("mobile-menu-button");
  const mobileMenu = document.getElementById("mobile-menu");
  const mobileMenuIcon = document.getElementById("mobile-menu-icon");

  const mobileThemeToggle = document.querySelector<HTMLElement>(
    "[data-mobile-theme-toggle]",
  );
  const mobileThemePanel = document.querySelector<HTMLElement>(
    "[data-mobile-theme-panel]",
  );
  const mobileThemeIcon = document.querySelector<HTMLElement>(
    "[data-mobile-theme-icon]",
  );

  const mobileUploadToggle = document.querySelector<HTMLElement>(
    "[data-mobile-upload-toggle]",
  );
  const mobileUploadPanel = document.querySelector<HTMLElement>(
    "[data-mobile-upload-panel]",
  );
  const mobileUploadIcon = document.querySelector<HTMLElement>(
    "[data-mobile-upload-icon]",
  );

  const menuIcon =
    '<path d="M4 6h16"></path><path d="M4 12h16"></path><path d="M4 18h16"></path>';
  const closeIcon = '<path d="M18 6 6 18"></path><path d="m6 6 12 12"></path>';

  const setSubmenuState = (
    toggle: HTMLElement | null,
    panel: HTMLElement | null,
    icon: HTMLElement | null,
    isOpen: boolean,
  ) => {
    panel?.classList.toggle("hidden", !isOpen);
    icon?.classList.toggle("rotate-180", isOpen);
    toggle?.setAttribute("aria-expanded", String(isOpen));
  };

  const setMobileMenuState = (isOpen: boolean) => {
    if (!mobileMenuButton || !mobileMenu) return;

    mobileMenu.classList.toggle("hidden", !isOpen);
    mobileMenu.setAttribute("aria-hidden", String(!isOpen));
    mobileMenuButton.setAttribute("aria-expanded", String(isOpen));
    mobileMenuButton.setAttribute(
      "aria-label",
      isOpen ? "關閉選單" : "開啟選單",
    );

    if (mobileMenuIcon) {
      mobileMenuIcon.innerHTML = isOpen ? closeIcon : menuIcon;
    }

    document.documentElement.classList.toggle("mobile-menu-open", isOpen);
    document.body.classList.toggle("mobile-menu-open", isOpen);

    if (isOpen) {
      navbar?.classList.remove("-translate-y-full");
      mobileMenu.scrollTop = 0;
    } else {
      setSubmenuState(
        mobileThemeToggle,
        mobileThemePanel,
        mobileThemeIcon,
        false,
      );
      setSubmenuState(
        mobileUploadToggle,
        mobileUploadPanel,
        mobileUploadIcon,
        false,
      );
    }
  };

  mobileMenuButton?.addEventListener("click", () => {
    const isOpen = mobileMenuButton.getAttribute("aria-expanded") === "true";
    setMobileMenuState(!isOpen);
  });

  mobileThemeToggle?.addEventListener("click", () => {
    const isOpen = mobileThemeToggle.getAttribute("aria-expanded") === "true";
    setSubmenuState(
      mobileThemeToggle,
      mobileThemePanel,
      mobileThemeIcon,
      !isOpen,
    );
  });

  mobileUploadToggle?.addEventListener("click", () => {
    const isOpen = mobileUploadToggle.getAttribute("aria-expanded") === "true";
    setSubmenuState(
      mobileUploadToggle,
      mobileUploadPanel,
      mobileUploadIcon,
      !isOpen,
    );
  });

  mobileMenu?.querySelectorAll<HTMLAnchorElement>("a[href]").forEach((link) => {
    link.addEventListener("click", () => {
      setMobileMenuState(false);
    });
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      setMobileMenuState(false);
    }
  });

  let lastScrollY = window.scrollY;
  let scrollTicking = false;

  const updateNavbarVisibility = () => {
    if (!navbar) return;

    const currentScrollY = window.scrollY;
    const isDesktop = window.innerWidth >= 1024;
    const isMenuOpen =
      mobileMenuButton?.getAttribute("aria-expanded") === "true";

    if (isDesktop || isMenuOpen || currentScrollY <= 16) {
      navbar.classList.remove("-translate-y-full");
      lastScrollY = currentScrollY;
      return;
    }

    const delta = currentScrollY - lastScrollY;

    // 手機向下滑動時收起導覽列；往上滑時重新顯示。
    if (delta > 6 && currentScrollY > 96) {
      navbar.classList.add("-translate-y-full");
    } else if (delta < -6) {
      navbar.classList.remove("-translate-y-full");
    }

    lastScrollY = currentScrollY;
  };

  window.addEventListener(
    "scroll",
    () => {
      if (scrollTicking) return;

      scrollTicking = true;
      window.requestAnimationFrame(() => {
        updateNavbarVisibility();
        scrollTicking = false;
      });
    },
    { passive: true },
  );

  window.addEventListener("resize", () => {
    if (window.innerWidth >= 1024) {
      setMobileMenuState(false);
      navbar?.classList.remove("-translate-y-full");
    }
    lastScrollY = window.scrollY;
  });
</script>

<style is:global>
  #mobile-menu {
    -webkit-overflow-scrolling: touch;
    touch-action: pan-y;
  }

  html.mobile-menu-open,
  body.mobile-menu-open {
    overflow: hidden;
  }
</style>
